# Local Docker Compose defaults only. Replace these values before starting.
MARIADB_DATABASE=virtual_teaching
MARIADB_USER=virtualteach
MARIADB_PASSWORD=change-this-local-password
MARIADB_ROOT_PASSWORD=change-this-root-password

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=virtual_teaching
DB_USERNAME=virtualteach
# Keep DB_PASSWORD equal to MARIADB_PASSWORD above.
DB_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION=86400000
